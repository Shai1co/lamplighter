# Lamplighter — StoryGen environment variables.
#
# Copy this file to .env.local and fill in the keys for whichever providers
# you want the in-app "Create a Story" feature to use. .env.local is
# git-ignored — never commit real keys. Everything here is read only by
# src/server/env.ts (a Node-only module); none of it is reachable from
# browser code, and none of it is ever echoed back in an API response.
#
# Nothing here is required to run Lamplighter itself. Without any keys set,
# the app still boots, plays the anthology, and — for the story generator —
# the "mock" provider still works with no key at all, so the whole
# generate -> validate -> write -> play pipeline is testable offline.

# ── Defaults ──────────────────────────────────────────────────────────────

# Which provider "Create a Story" uses when the request doesn't say.
# One of: gemini | xai | openai-compatible | anthropic | mock
# STORYGEN_PROVIDER=gemini

# Overrides the resolved provider's own default text model (see the
# per-provider *_MODEL variables below for provider-specific defaults).
# STORYGEN_MODEL=

# Overrides the stories/ root (default: <repo>/stories). Mainly for tests.
# STORYGEN_STORIES_DIR=

# Forces the art backend used for generated-story images: gemini | mock | none.
# Default: gemini when GEMINI_KEY is set, else none.
# STORYGEN_IMAGE_BACKEND=

# ── Gemini ────────────────────────────────────────────────────────────────

GEMINI_KEY=
# Fallback name for the same key, if you already export it that way:
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.7-flash
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# ── xAI (Grok) ────────────────────────────────────────────────────────────

XAI_API_KEY=
# Fallback name for the same key:
# GROK_API_KEY=
# XAI_MODEL=grok-4

# ── OpenAI-compatible (OpenAI, Ollama, LM Studio, OpenRouter, ...) ─────────

OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5

# ── Anthropic ─────────────────────────────────────────────────────────────

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
