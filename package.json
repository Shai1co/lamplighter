{
  "name": "lamplighter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A cinematic Three.js narrative-quest engine in the spirit of Eliza — built so adding new stories is trivial.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "check": "node tools/build-check.mjs",
    "new-story": "node tools/new-story.mjs",
    "gen-assets": "node tools/gen-assets.mjs",
    "test:unit": "node --test tests/validate.test.ts",
    "test:e2e": "node tests/e2e.mjs",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.1.0",
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource-variable/jetbrains-mono": "^5.1.0",
    "gsap": "^3.12.5",
    "howler": "^2.2.4",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/howler": "^2.2.11",
    "@types/node": "^26.2.0",
    "@types/three": "^0.169.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.62.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.8"
  }
}
